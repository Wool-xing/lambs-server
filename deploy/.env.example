# Lambs Server — required environment variables
# Copy to /home/ubuntu/apps/lambs-server/.env and chmod 600

# PostgreSQL connection (supports postgresql+asyncpg:// prefix — auto-converted)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# JWT signing secret (64+ hex chars recommended: openssl rand -hex 32)
JWT_SECRET=your-64-char-hex-secret-here

# Server port (optional, default 3602)
PORT=3602

# Config file path (optional)
LAMBS_CONFIG_PATH=/home/ubuntu/apps/lambs-server/lambs_config.json
