# Lambs Server environment — copy to .env and fill in real values.
# The service reads EnvironmentFile=/home/ubuntu/apps/lambs-server/.env (see deploy/lambs-server.service).

# ── Required ──────────────────────────────────────────────────
# PostgreSQL DSN. Accepts postgres:// and postgresql+asyncpg:// prefixes.
DATABASE_URL=postgres://lambs_admin:CHANGE_ME@127.0.0.1:5433/lambs

# JWT signing secret, 64 hex chars recommended:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# ── Optional ──────────────────────────────────────────────────
# HTTP listen port (default 3602)
PORT=3602

# JSON config file path (default /home/ubuntu/apps/lambs-server/lambs_config.json)
LAMBS_CONFIG_PATH=/home/ubuntu/apps/lambs-server/lambs_config.json

# Initial super_admin password on first startup (default: none — register first user)
# INITIAL_PASSWORD=

# ── Compute agent (Windows node) ──────────────────────────────
# URL of the Windows compute agent (compute-node/compute-agent.py)
COMPUTE_AGENT_URL=http://YOUR_AGENT_IP:19527
# Shared token — must match the agent's COMPUTE_TOKEN (ACL file or env)
COMPUTE_AGENT_TOKEN=CHANGE_ME

# ── Linux node agent (optional second node) ───────────────────
# WOOL_AGENT_URL=http://YOUR_LINUX_NODE:19528

# ── TCP proxy ─────────────────────────────────────────────────
# Comma-separated source IP allowlist for project TCP proxies.
# Empty = fail-closed (loopback only). Set the public IP of your nginx host.
TCP_PROXY_ALLOWED_IPS=YOUR_NGINX_PUBLIC_IP

# ── Telegram backup bot ───────────────────────────────────────
# Path to secrets file: TG_BOT_TOKEN / TG_CHANNEL_BACKUP / GPG_PASS (chmod 600)
TG_SECRETS_PATH=/opt/wool-tools/.tg-secrets
# Admin chat IDs allowed to drive the bot (comma-separated)
# TG_ADMIN_CHAT_IDS=
# Webhook wake-up endpoint
# TG_WEBHOOK_URL=

# ── Gate / proxies ────────────────────────────────────────────
# Host header gate for nginx auth_request deployments
# GATE_HOST=
# Comma-separated trusted reverse-proxy CIDRs (X-Forwarded-For handling)
# LAMBS_TRUSTED_PROXIES=
# Comma-separated CORS origins
# CORS_ORIGIN=

# ── Safety ────────────────────────────────────────────────────
# Minimum free disk MB before auto-stop of managed processes
# LAMBS_MIN_FREE_MB=
